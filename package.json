{
  "name": "sweets-by-shyee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "./scripts/dev/db.sh start",
    "db:stop": "./scripts/dev/db.sh stop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/migration/import-content.ts",
    "db:seed:demo": "tsx scripts/db/seed-demo.ts",
    "admin:create": "tsx scripts/db/create-admin.ts",
    "jobs:run": "tsx --conditions=react-server scripts/jobs/run.ts",
    "audit:crawl": "tsx scripts/audit/crawl.ts",
    "audit:screenshots": "tsx scripts/audit/screenshots.ts",
    "migrate:assets": "tsx scripts/migration/download-assets.ts",
    "migrate:normalize": "tsx scripts/migration/normalize.ts",
    "migrate:redirects": "tsx scripts/migration/build-redirects.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "audit:perf": "tsx scripts/audit/perf.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.0"
}
