# Copy to .env.local for local development. Never commit real secrets.
# In staging/production set these in the hosting provider's secret manager.

# local | test | staging | production  (only "production" allows search indexing)
APP_ENV=local
# Public base URL, used for canonical links, sitemaps, emails and payment redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string. Local: pnpm db:start provides this one.
DATABASE_URL=postgres://sweets@127.0.0.1:54329/sweets
DATABASE_POOL_MAX=10

# Long random string (e.g. `openssl rand -base64 48`). Required in production.
APP_SECRET=dev-only-insecure-secret-change-me

# Payments: none (checkout off) | stripe | fake (local/e2e only, refused in production)
PAYMENTS_PROVIDER=fake
# Stripe (test keys start sk_test_ / whsec_). Webhook endpoint: <site>/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email: console (logs only) | resend | memory (tests only)
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Must be on a domain verified with the email provider.
EMAIL_FROM="Sweets by Shyee <orders@example.com>"
# Where new-order and new-request notifications go (defaults to the public contact email in settings).
BUSINESS_NOTIFICATION_EMAIL=

# Uploaded files (private customer photos + owner media). Must NOT be inside /public.
# Needs persistent disk; see docs/deployment.md for serverless hosting.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=8
MAX_UPLOAD_FILES=5

# Trust X-Forwarded-For for rate limiting (true behind Vercel/Render/Fly/nginx).
TRUST_PROXY_HEADERS=true

# Background jobs over HTTP: POST /api/cron with "Authorization: Bearer <CRON_SECRET>".
# Leave empty to disable the endpoint (then schedule `pnpm jobs:run` instead). At least 24 characters.
CRON_SECRET=
